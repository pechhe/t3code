{
  "name": "t3",
  "version": "0.1.8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pingdotgg/t3code",
    "directory": "apps/server"
  },
  "bin": {
    "t3": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=../../packages/client-runtime/src --watch-path=../../packages/contracts/src --watch-path=../../packages/effect-acp/src --watch-path=../../packages/effect-codex-app-server/src --watch-path=../../packages/provider-acp/src --watch-path=../../packages/provider-acp-registry/src --watch-path=../../packages/provider-core/src --watch-path=../../packages/provider-cursor/src --watch-path=../../packages/provider-fx/src --watch-path=../../packages/provider-grok/src --watch-path=../../packages/provider-kiro/src --watch-path=../../packages/provider-muse/src --watch-path=../../packages/provider-opencode/src --watch-path=../../packages/provider-pi/src --watch-path=../../packages/provider-testing/src --watch-path=../../packages/secret-provider-core/src --watch-path=../../packages/secret-provider-definitions/src --watch-path=../../packages/secret-provider-onepassword/src --watch-path=../../packages/shared/src --watch-path=../../packages/source-control-azure-devops/src --watch-path=../../packages/source-control-bitbucket/src --watch-path=../../packages/source-control-core/src --watch-path=../../packages/source-control-cursor-origin/src --watch-path=../../packages/source-control-definitions/src --watch-path=../../packages/source-control-forgejo/src --watch-path=../../packages/source-control-gitcafe/src --watch-path=../../packages/source-control-github/src --watch-path=../../packages/source-control-gitlab/src --watch-path=../../packages/source-control-testing/src --watch-path=../../packages/ssh/src --watch-path=../../packages/tailscale/src --watch-path=package.json src/bin.ts",
    "dev:built": "vp run dev",
    "build:bundle": "vp pack",
    "build:exe": "node scripts/cli.ts build-exe",
    "start": "node dist/bin.mjs",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "speech:catalog:sync": "node scripts/sync-speech-catalog.ts",
    "speech:catalog:check": "node scripts/sync-speech-catalog.ts --check",
    "test": "vp test run",
    "record:codex-replay": "bun scripts/record-codex-app-server-replay-fixture.ts",
    "record:claude-replay": "bun scripts/record-claude-agent-sdk-replay-fixture.ts",
    "record:cursor-replay": "node --env-file-if-exists=../../.env --experimental-strip-types scripts/record-cursor-agent-sdk-replay-fixture.ts",
    "record:pi-replay": "node scripts/record-pi-rpc-replay-fixture.ts",
    "record:grok-replay": "node scripts/record-grok-acp-replay-fixture.ts",
    "record:fx-replay": "node scripts/record-fx-acp-replay-fixture.ts",
    "record:kiro-replay": "node scripts/record-kiro-acp-replay-fixture.ts",
    "record:muse-replay": "node scripts/record-muse-msp-replay-fixture.ts",
    "generate": "graphqlgen",
    "generate:expo-schema": "node scripts/fetch-expo-schema.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.321",
    "@cursor/sdk": "1.3.1",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@ff-labs/fff-node": "0.11.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@muse-code/sdk": "1.4.13",
    "@napi-rs/keyring": "^2.1.2",
    "@t3tools/provider-acp": "workspace:*",
    "@t3tools/provider-acp-registry": "workspace:*",
    "@t3tools/provider-core": "workspace:*",
    "@t3tools/provider-cursor": "workspace:*",
    "@t3tools/provider-fx": "workspace:*",
    "@t3tools/provider-grok": "workspace:*",
    "@t3tools/provider-kiro": "workspace:*",
    "@t3tools/provider-muse": "workspace:*",
    "@t3tools/provider-opencode": "workspace:*",
    "@t3tools/provider-pi": "workspace:*",
    "@t3tools/source-control-azure-devops": "workspace:*",
    "@t3tools/source-control-bitbucket": "workspace:*",
    "@t3tools/source-control-core": "workspace:*",
    "@t3tools/source-control-cursor-origin": "workspace:*",
    "@t3tools/source-control-definitions": "workspace:*",
    "@t3tools/source-control-forgejo": "workspace:*",
    "@t3tools/source-control-gitcafe": "workspace:*",
    "@t3tools/source-control-github": "workspace:*",
    "@t3tools/source-control-gitlab": "workspace:*",
    "character-entities": "2.0.2",
    "diff": "8.0.3",
    "effect": "catalog:",
    "ffi-rs": "1.3.7",
    "node-pty": "^1.2.0-beta.15",
    "playwright-core": "1.65.0",
    "proper-lockfile": "4.1.2",
    "saxes": "6.0.0",
    "stream-chain": "^4.4.1",
    "stream-json": "3.8.0",
    "transcribe-cpp": "0.4.1",
    "undici": "catalog:",
    "yaml": "catalog:",
    "yauzl": "^3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@effect/graphql-generator": "catalog:",
    "@effect/vitest": "catalog:",
    "@handy-computer/models": "0.2.3",
    "@opencode-ai/sdk": "^1.3.15",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/provider-testing": "workspace:*",
    "@t3tools/secret-provider-core": "workspace:*",
    "@t3tools/secret-provider-definitions": "workspace:*",
    "@t3tools/secret-provider-onepassword": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@t3tools/source-control-testing": "workspace:*",
    "@t3tools/ssh": "workspace:*",
    "@t3tools/tailscale": "workspace:*",
    "@t3tools/web": "workspace:*",
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "@types/yauzl": "^3.4.0",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "graphql": "17.1.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
