{
  "version": 1,
  "projectCode": "t3",
  "tracker": "build",
  "integrationBranch": "t3peach",
  "remote": "origin",
  "spares": 8,
  "generatedPaths": [
    ".t3/userdata",
    ".t3/caches",
    ".t3/test-tmp",
    "apps/*/dist-electron",
    ".pnpm-store"
  ],
  "evidencePaths": [
    ".t3/review"
  ],
  "requiredLandingVerification": [
    {
      "executable": "pnpm",
      "args": [
        "exec",
        "vp",
        "test",
        "run",
        "apps/server/src/mcp/OrchestratorMcpService.test.ts",
        "apps/server/src/experiments/ExperimentService.test.ts",
        "apps/server/src/agents/AgentPolicyService.test.ts"
      ]
    },
    {
      "executable": "pnpm",
      "args": [
        "exec",
        "vp",
        "run",
        "--filter",
        "t3",
        "typecheck"
      ]
    },
    {
      "executable": "pnpm",
      "args": [
        "exec",
        "vp",
        "run",
        "--filter",
        "@t3tools/web",
        "typecheck"
      ]
    },
    {
      "executable": "pnpm",
      "args": [
        "exec",
        "vp",
        "test",
        "run",
        "src/orchestration-v2/ContextRollover.test.ts",
        "src/orchestration-v2/ContextRollover.integration.test.ts"
      ],
      "cwd": "apps/server"
    },
    {
      "executable": "node",
      "args": [
        "scripts/fork-upstream-receipt.ts",
        "verify",
        "--landed",
        "origin/t3peach"
      ]
    }
  ],
  "audit": {
    "commands": [
      {
        "executable": "pnpm",
        "args": [
          "install",
          "--frozen-lockfile"
        ]
      },
      {
        "executable": "pnpm",
        "args": [
          "exec",
          "vp",
          "run",
          "--filter",
          "t3",
          "typecheck"
        ]
      },
      {
        "executable": "pnpm",
        "args": [
          "exec",
          "vp",
          "run",
          "--filter",
          "@t3tools/web",
          "typecheck"
        ]
      },
      {
        "executable": "pnpm",
        "args": [
          "run",
          "test:audit"
        ]
      }
    ],
    "timeOfDay": "02:00",
    "timeZone": "Europe/London"
  },
  "budgets": {
    "verifyP50Seconds": 90,
    "verifyP90Seconds": 180,
    "testFileSeconds": 30
  }
}
